// MQTT
#define MQTT_BROKER       "YourBrokerIp"
#define MQTT_PORT         8883
#define MQTT_USER         "mqtt_user"
#define MQTT_PASSWORD     "mqtt_password"

// Root certificate for broker MQTT (PEM)
// If left empty, MQTT stays disabled unless MQTT_ALLOW_INSECURE is defined below.
static const char* MQTT_CA_CERT = R"EOF(
)EOF";

// Uncomment to connect without verifying the broker's certificate (only if
// MQTT_CA_CERT is empty). The MQTT password is then exposed to anyone who can
// impersonate the broker on your network.
